# ============================================================
# AgriLedger — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env — it contains secrets.
# ============================================================

# --- Hardhat / Scripts (server-side only, never commit) ---

# Polygon Amoy RPC URL (get a free key from https://alchemy.com or use public)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private keys — ONLY for throwaway testnet wallets!
# Never use wallets that hold real funds.
DEPLOYER_PRIVATE_KEY=            # Admin wallet — used to deploy and manage the contract
FARMER_PRIVATE_KEY=              # Used by seed.ts to create demo batches
LAB_PRIVATE_KEY=                 # Used by seed.ts to certify demo batches
DISTRIBUTOR_PRIVATE_KEY=         # Used by seed.ts to record hub receipt

# Public addresses of demo actors (used by grant-roles.ts)
FARMER_ADDRESS=
LAB_ADDRESS=
DISTRIBUTOR_ADDRESS=

# Display names for demo actors
FARMER_NAME="Nilgiri Organic Farm"
LAB_NAME="Tamil Nadu Agri Testing Lab"
DISTRIBUTOR_NAME="Coimbatore Fresh Hub"

# Polygonscan API key for contract verification
# Get one at https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=

# Pinata JWT — server-side only, never expose to the browser
# Get one at https://app.pinata.cloud/developers/api-keys
PINATA_JWT=

# --- Frontend (public variables, prefixed with VITE_) ---
# These are embedded in the browser bundle — only put PUBLIC values here.

# Public read-only RPC for the consumer verify page (no wallet needed)
VITE_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Your Pinata dedicated gateway domain (e.g. your-name.mypinata.cloud)
VITE_PINATA_GATEWAY=

# The deployed app URL (set after Vercel deploy, then redeploy)
VITE_PUBLIC_APP_URL=http://localhost:5173
